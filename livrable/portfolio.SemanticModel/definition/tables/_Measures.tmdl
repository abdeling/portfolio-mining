	measure 'Top 2 Controllable Reasons Hours' = ```
			
			VAR _reasons = CALCULATETABLE ( VALUES ( DimReason[Reason] ), DimReason[ControlClass] = "Controllable" )
			RETURN SUMX ( TOPN ( 2, _reasons, [Delay Hours], DESC ), [Delay Hours] )
			
			```
		displayFolder: Delays & Standby
		lineageTag: 502e6fee-37e4-467f-ae58-040149603657

	measure 'Reason Benchmark Gap Hours' = ```
			
			[Top 2 Controllable Reasons Hours] * [Opportunity Reduction %]
			
			```
		displayFolder: Delays & Standby
		lineageTag: 118b3750-1bca-4255-b050-f4a43d8ea9e5

	measure 'Estimated Opportunity Tonnes' = ```
			
			DIVIDE ( [Reason Benchmark Gap Hours] * [Haul Truck Working Efficiency] * [Tonnes / Working h], 1000 )
			
			```
		displayFolder: Production
		lineageTag: b3e85192-4d29-4729-b8b9-b99c13671172

	measure 'Unit Controllable Loss Rate' = ```
			
			DIVIDE ( [Controllable Delay Hours], [Calendar Hours] )
			
			```
		displayFolder: Delays & Standby
		lineageTag: 39f25ae7-352c-420d-95fe-6c2bb8ca0962
		formatString: 0.0%;-0.0%;0.0%

	measure 'Best Quartile Unit Controllable Loss Rate' = ```
			
			VAR _units = ALLSELECTED ( DimEquipment[UnitCode] )
			RETURN PERCENTILEX.INC ( _units, CALCULATE ( [Unit Controllable Loss Rate] ), 0.25 )
			
			```
		displayFolder: Delays & Standby
		lineageTag: 6230d7fa-9d8f-4bff-bd10-46e2e4f4b7f8
		formatString: 0.0%;-0.0%;0.0%

	measure 'Unit Benchmark Gap Hours' = ```
			
			VAR _bq = [Best Quartile Unit Controllable Loss Rate]
			VAR _units = ALLSELECTED ( DimEquipment[UnitCode] )
			RETURN
			SUMX (
			    _units,
			    VAR _rate = CALCULATE ( [Unit Controllable Loss Rate] )
			    VAR _cal = CALCULATE ( [Calendar Hours] )
			    RETURN MAX ( 0, ( _rate - _bq ) * _cal )
			)
			
			```
		displayFolder: Delays & Standby
		lineageTag: a4cc818f-9c1c-42ca-a2e5-57953e6e7193

	measure 'Opportunity vs Plan %' = ```
			
			DIVIDE ( [Estimated Opportunity Tonnes] * 1000, [Haulage Plan Tonnes] )
			
			```
		displayFolder: Production Opportunity
		lineageTag: 84502d31-9a01-4cd0-8dcf-0542c35fa5a7
		formatString: 0.0%;-0.0%;0.0%

	measure 'Open WOs by Age Bucket' = ```
			
			VAR _asof = MAX ( DimDate[Date] ) + 1
			VAR _bucket = SELECTEDVALUE ( BacklogAgeBucket[Bucket] )
			RETURN
			CALCULATE (
			    COUNTROWS ( FactWorkOrder ),
			    REMOVEFILTERS ( DimDate ),
			    FILTER (
			        FactWorkOrder,
			        VAR _age = DATEDIFF ( FactWorkOrder[StartTimestamp], _asof, DAY )
			        VAR _open = FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof )
			        RETURN _open && SWITCH ( _bucket, "<7 d", _age < 7, "7-14 d", _age >= 7 && _age < 14, "14-30 d", _age >= 14 && _age < 30, "30-60 d", _age >= 30 && _age < 60, "60+ d", _age >= 60, FALSE () )
			    )
			)
			
			```
		displayFolder: Maintenance
		lineageTag: 27d976b9-3adb-42d3-9055-c3624133937b

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table
