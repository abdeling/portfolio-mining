	measure 'TUM Reconciliation Difference' = ```
			
			VAR _leaf = [Unscheduled Hours] + [Downtime Hours] + [Operating Standby Hours] + [External Standby Hours] + [Operating Delay Hours] + [Non-Productive Hours] + [Productive Hours]
			RETURN [Calendar Hours] - _leaf
			
			```
		displayFolder: Time Usage Model\Reconciliation
		lineageTag: 17e874a1-4321-41f5-88f6-f6205ab3a344

	measure 'TUM Reconciliation %' = ```
			
			DIVIDE ( [Calendar Hours] - ABS ( [TUM Reconciliation Difference] ), [Calendar Hours] )
			
			```
		displayFolder: Time Usage Model\Reconciliation
		lineageTag: 93057269-a440-413c-8eb2-4587bb5e591a
		formatString: 0.0%;-0.0%;0.0%

	measure 'Recon CT = ST + UT' = ```
			
