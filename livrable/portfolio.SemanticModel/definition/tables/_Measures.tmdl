	measure 'Failure Frequency / 100 Op h' = ```
			
			DIVIDE ( [Failure Count] * 100, [Operating Hours] )
			
			```
		displayFolder: Reliability
		lineageTag: 9fa56a23-291b-4e31-b6c2-8a05f0743639

	measure 'Inherent Availability Ai' = ```
			
			DIVIDE ( [MTBF], [MTBF] + [MTTR] )
			
			```
		displayFolder: Reliability
		lineageTag: 367eb92a-83cf-4b07-8e02-33448f2b511e
		formatString: 0.0%;-0.0%;0.0%

	measure 'Achieved Availability Aa' = ```
			
			DIVIDE ( [Operating Hours], [Operating Hours] + [Active Repair Hours] + [Planned Maintenance Hours] )
			
			```
		displayFolder: Reliability
		lineageTag: 868d6be0-19eb-493d-9608-953262e6912d
		formatString: 0.0%;-0.0%;0.0%

	measure 'Operational Availability Ao' = ```
			
			DIVIDE ( [Operating Hours], [Operating Hours] + [Active Repair Hours] + [Planned Maintenance Hours] + [Logistics Wait Hours] )
			
			```
		displayFolder: Reliability
		lineageTag: 8da3f0d9-7147-4871-97cf-d60dabdbb51b
		formatString: 0.0%;-0.0%;0.0%

	measure 'PM Burden' = ```
			
			( [Inherent Availability Ai] - [Achieved Availability Aa] ) * 100
			
			```
		displayFolder: Reliability
		lineageTag: 696c7013-c937-4c29-81f8-e870c8759fab

	measure 'Logistics Burden' = ```
			
			( [Achieved Availability Aa] - [Operational Availability Ao] ) * 100
			
			```
		displayFolder: Reliability
		lineageTag: 627d8ab6-3958-4808-8c5b-c6e6027596b3

	measure 'MTBF Monthly Mean' = ```
			
			VAR _months = ALLSELECTED ( DimDate[FiscalMonthNumber] )
			RETURN AVERAGEX ( _months, CALCULATE ( [MTBF] ) )
			
			```
		displayFolder: Reliability
		lineageTag: 3dd7c730-14a4-4840-abef-91607728e3e1
		formatString: " 0.0 h"

	measure 'MTBF Monthly StdDev' = ```
			
			VAR _months = ALLSELECTED ( DimDate[FiscalMonthNumber] )
			RETURN STDEVX.S ( _months, CALCULATE ( [MTBF] ) )
			
			```
		displayFolder: Reliability
		lineageTag: 5c59b6dd-a1fc-4136-8089-8514f3cbc2b1
		formatString: " 0.0 h"

	measure 'MTBF UCL' = ```
			
			[MTBF Monthly Mean] + 3 * [MTBF Monthly StdDev]
			
			```
		displayFolder: Reliability
		lineageTag: a978e42a-6d74-4732-81ca-16a2b6e880fd
		formatString: " 0.0 h"

	measure 'MTBF LCL' = ```
			
			MAX ( 0, [MTBF Monthly Mean] - 3 * [MTBF Monthly StdDev] )
			
			```
		displayFolder: Reliability
		lineageTag: 7bd170b9-cbc0-4e04-9d2e-1ed2dd9e86da
		formatString: " 0.0 h"

	measure 'Component Failure Share' = ```
			
