// Welcome to DAX query view! Learn more about DAX queries at https://aka.ms/dax-queries.
// Right-click on tables, columns, or measures in the data pane to access quick queries, or ask Copilot for help writing DAX.
DEFINE MEASURE '_measures'['Calendar Hours'] = SUM ( FactState[DurationHours] )


define MEASURE '_measures'[Non-scheduled Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "NS" )
define MEASURE '_measures'[Scheduled Hours] = [Calendar Hours] - [Non-scheduled Hours]
define MEASURE '_measures'[Planned Maintenance Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "PM" )
define MEASURE '_measures'[Breakdown Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "BD" )
define MEASURE '_measures'[Maintenance Delay Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "MD" )
define MEASURE '_measures'[Downtime Hours] = [Planned Maintenance Hours] + [Breakdown Hours] + [Maintenance Delay Hours]
define MEASURE '_measures'[Available Hours] = [Scheduled Hours] - [Downtime Hours]
define MEASURE '_measures'[Standby Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "SB" )
define MEASURE '_measures'[Operating Delay Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "OD" )
define MEASURE '_measures'[Operating Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] IN { "PR", "OD" } )
define MEASURE '_measures'[Productive Hours] = CALCULATE ( [Calendar Hours], DimState[StateCode] = "PR" )
define MEASURE '_measures'[Physical Availability] = DIVIDE ( [Available Hours], [Scheduled Hours] )
define MEASURE '_measures'[Use of Availability] = DIVIDE ( [Operating Hours], [Available Hours] )
define MEASURE '_measures'[Productive Efficiency] = DIVIDE ( [Productive Hours], [Operating Hours] )
define MEASURE '_measures'[Productive % Calendar] = DIVIDE ( [Productive Hours], [Calendar Hours] )
define MEASURE '_measures'[Standby % Calendar] = DIVIDE ( [Standby Hours], [Calendar Hours] )
define MEASURE '_measures'[Downtime % Scheduled] = DIVIDE ( [Downtime Hours], [Scheduled Hours] )
define MEASURE '_measures'[Operating Delay % Operating] = DIVIDE ( [Operating Delay Hours], [Operating Hours] )
define MEASURE '_measures'[TUM Reconciliation Difference] = VAR _states = [Non-scheduled Hours] + [Planned Maintenance Hours] + [Breakdown Hours] + [Maintenance Delay Hours] + [Standby Hours] + [Operating Delay Hours] + [Productive Hours] RETURN [Calendar Hours] - _states
define MEASURE '_measures'[TUM Reconciliation %] = DIVIDE ( [Calendar Hours] - ABS ( [TUM Reconciliation Difference] ), [Calendar Hours] )
define MEASURE '_measures'[Fleet Median PA] = MEDIANX ( ALLSELECTED ( DimEquipment[UnitCode] ), CALCULATE ( [Physical Availability] ) )
define MEASURE '_measures'[PA vs Fleet Median] = ( [Physical Availability] - [Fleet Median PA] ) * 100
define MEASURE '_measures'[PA Unit Rank] = RANKX ( ALLSELECTED ( DimEquipment[UnitCode] ), [Physical Availability], , DESC, DENSE )
define MEASURE '_measures'[Class Median PA] = VAR _class = SELECTEDVALUE ( DimEquipment[EquipmentClass] ) RETURN MEDIANX ( FILTER ( ALLSELECTED ( DimEquipment ), DimEquipment[EquipmentClass] = _class ), CALCULATE ( [Physical Availability] ) )
define MEASURE '_measures'[Delay Hours] = CALCULATE ( [Calendar Hours], NOT ISBLANK ( FactState[ReasonID] ) )
define MEASURE '_measures'[Controllable Delay Hours] = CALCULATE ( [Delay Hours], DimDelayReason[ControlClass] = "Controllable" )
define MEASURE '_measures'[Inherent Delay Hours] = CALCULATE ( [Delay Hours], DimDelayReason[ControlClass] = "Inherent" )
define MEASURE '_measures'[Planned Delay Hours] = CALCULATE ( [Delay Hours], DimDelayReason[ControlClass] = "Planned" )
define MEASURE '_measures'[Controllable Share of Delay] = DIVIDE ( [Controllable Delay Hours], [Delay Hours] )
define MEASURE '_measures'[Delay Share of Calendar] = DIVIDE ( [Delay Hours], [Calendar Hours] )
define MEASURE '_measures'[Start-of-shift Delay Hours] = CALCULATE ( [Delay Hours], FactState[HourOfShift] = 0 )
define MEASURE '_measures'[Start-of-shift Delay Share] = DIVIDE ( [Start-of-shift Delay Hours], [Delay Hours] )
define MEASURE '_measures'[Largest Delay Reason Hours] = MAXX ( ALLSELECTED ( DimDelayReason[Reason] ), CALCULATE ( [Delay Hours] ) )
define MEASURE '_measures'[Available-but-not-producing Hours] = [Standby Hours] + [Operating Delay Hours]
define MEASURE '_measures'[Failure Count] = COUNTROWS ( FactFailure )
define MEASURE '_measures'[Active Repair Hours] = SUM ( FactFailure[ActiveRepairHours] )
define MEASURE '_measures'[Logistics Wait Hours] = SUM ( FactFailure[LogisticsWaitHours] )
define MEASURE '_measures'[Failure Downtime Hours] = SUM ( FactFailure[TotalDownHours] )
define MEASURE '_measures'[MTBF] = DIVIDE ( [Operating Hours], [Failure Count] )
define MEASURE '_measures'[MTTR] = DIVIDE ( [Active Repair Hours], [Failure Count] )
define MEASURE '_measures'[MDT] = DIVIDE ( [Active Repair Hours] + [Logistics Wait Hours], [Failure Count] )
define MEASURE '_measures'[Failure Frequency / 100 Op h] = DIVIDE ( [Failure Count] * 100, [Operating Hours] )
define MEASURE '_measures'[Inherent Availability Ai] = DIVIDE ( [MTBF], [MTBF] + [MTTR] )
define MEASURE '_measures'[Achieved Availability Aa] = DIVIDE ( [Operating Hours], [Operating Hours] + [Active Repair Hours] + [Planned Maintenance Hours] )
define MEASURE '_measures'[Operational Availability Ao] = DIVIDE ( [Operating Hours], [Operating Hours] + [Active Repair Hours] + [Planned Maintenance Hours] + [Logistics Wait Hours] )
define MEASURE '_measures'[PM Burden] = ( [Inherent Availability Ai] - [Achieved Availability Aa] ) * 100
define MEASURE '_measures'[Logistics Burden] = ( [Achieved Availability Aa] - [Operational Availability Ao] ) * 100
define MEASURE '_measures'[MTBF Monthly Mean] = VAR _months = ALLSELECTED ( DimDate[FiscalMonthNumber] ) RETURN AVERAGEX ( _months, CALCULATE ( [MTBF] ) )
define MEASURE '_measures'[MTBF Monthly StdDev] = VAR _months = ALLSELECTED ( DimDate[FiscalMonthNumber] ) RETURN STDEVX.S ( _months, CALCULATE ( [MTBF] ) )
define MEASURE '_measures'[MTBF UCL] = [MTBF Monthly Mean] + 3 * [MTBF Monthly StdDev]
define MEASURE '_measures'[MTBF LCL] = MAX ( 0, [MTBF Monthly Mean] - 3 * [MTBF Monthly StdDev] )
define MEASURE '_measures'[Component Failure Share] = DIVIDE ( [Failure Count], CALCULATE ( [Failure Count], REMOVEFILTERS ( DimComponent ) ) )
define MEASURE '_measures'[Component Failure Downtime Share] = DIVIDE ( [Failure Downtime Hours], CALCULATE ( [Failure Downtime Hours], REMOVEFILTERS ( DimComponent ) ) )
define MEASURE '_measures'[Work Orders] = COUNTROWS ( FactWorkOrder )
define MEASURE '_measures'[WO Labour Hours] = SUM ( FactWorkOrder[LabourHours] )
define MEASURE '_measures'[Planned Labour Hours] = CALCULATE ( [WO Labour Hours], FactWorkOrder[WorkType] = "Preventive" )
define MEASURE '_measures'[Planned Work Ratio] = DIVIDE ( [Planned Labour Hours], [WO Labour Hours] )
define MEASURE '_measures'[Maintenance Ratio] = DIVIDE ( [WO Labour Hours], [Operating Hours] )
define MEASURE '_measures'[WO Wait Hours] = SUM ( FactWorkOrder[WaitHours] )
define MEASURE '_measures'[WO Active Repair Hours] = SUM ( FactWorkOrder[ActiveRepairHours] )
define MEASURE '_measures'[Wait Share of MDT] = DIVIDE ( [WO Wait Hours], [WO Wait Hours] + [WO Active Repair Hours] )
define MEASURE '_measures'[Open Work Orders As Of] = VAR _asof = MAX ( DimDate[Date] ) + 1 RETURN CALCULATE ( COUNTROWS ( FactWorkOrder ), REMOVEFILTERS ( DimDate ), FILTER ( FactWorkOrder, FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) ) )
define MEASURE '_measures'[Open P1 Work Orders As Of] = VAR _asof = MAX ( DimDate[Date] ) + 1 RETURN CALCULATE ( COUNTROWS ( FactWorkOrder ), REMOVEFILTERS ( DimDate ), FactWorkOrder[Priority] = "P1", FILTER ( FactWorkOrder, FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) ) )
define MEASURE '_measures'[Open Backlog Hours As Of] = VAR _asof = MAX ( DimDate[Date] ) + 1 RETURN CALCULATE ( SUM ( FactWorkOrder[EstimatedRemainingLabourHours] ), REMOVEFILTERS ( DimDate ), FILTER ( FactWorkOrder, FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) ) )
define MEASURE '_measures'[Average Open WO Age Days] = VAR _asof = MAX ( DimDate[Date] ) + 1 RETURN CALCULATE ( AVERAGEX ( FILTER ( FactWorkOrder, FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) ), DATEDIFF ( FactWorkOrder[StartTimestamp], _asof, DAY ) ), REMOVEFILTERS ( DimDate ) )
define MEASURE '_measures'[Open WO 30+ Days] = VAR _asof = MAX ( DimDate[Date] ) + 1 RETURN CALCULATE ( COUNTROWS ( FactWorkOrder ), REMOVEFILTERS ( DimDate ), FILTER ( FactWorkOrder, FactWorkOrder[StartTimestamp] < _asof - 30 && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) ) )
define MEASURE '_measures'[Open WO 30+ %] = DIVIDE ( [Open WO 30+ Days], [Open Work Orders As Of] )
define MEASURE '_measures'[PM Services] = COUNTROWS ( FactPM )
define MEASURE '_measures'[PM Within Tolerance] = CALCULATE ( [PM Services], FactPM[WithinTolerance10Pct] = 1 )
define MEASURE '_measures'[PM Compliance] = DIVIDE ( [PM Within Tolerance], [PM Services] )
define MEASURE '_measures'[PM Past Tolerance] = CALCULATE ( [PM Services], FactPM[IntervalDeviationPct] > 10 )
define MEASURE '_measures'[Average PM Interval Deviation] = DIVIDE ( AVERAGE ( FactPM[IntervalDeviationPct] ), 100 )
define MEASURE '_measures'[Component Downtime Rank] = RANKX ( ALLSELECTED ( DimComponent[ComponentName] ), [Breakdown Hours], , DESC, DENSE )
define MEASURE '_measures'[Component Downtime Cumulative] = VAR _rank = [Component Downtime Rank] RETURN SUMX ( TOPN ( _rank, ALLSELECTED ( DimComponent[ComponentName] ), [Breakdown Hours], DESC ), [Breakdown Hours] )
define MEASURE '_measures'[Component Downtime Cumulative %] = DIVIDE ( [Component Downtime Cumulative], CALCULATE ( [Breakdown Hours], REMOVEFILTERS ( DimComponent ) ) )
define MEASURE '_measures'[Production Quantity] = SUM ( FactProduction[Quantity] )
define MEASURE '_measures'[Plan Quantity] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) VAR _activities = VALUES ( DimActivity[ActivityID] ) RETURN CALCULATE ( SUM ( FactPlan[PlanQuantity] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), TREATAS ( _activities, FactPlan[ActivityID] ) )
define MEASURE '_measures'[Achievement %] = DIVIDE ( [Production Quantity], [Plan Quantity] )
define MEASURE '_measures'[Tonnes Hauled] = CALCULATE ( [Production Quantity], DimActivity[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Haulage Plan Tonnes] = CALCULATE ( [Plan Quantity], DimActivity[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Haulage Achievement %] = DIVIDE ( [Tonnes Hauled], [Haulage Plan Tonnes] )
define MEASURE '_measures'[Loading Tonnes] = CALCULATE ( [Production Quantity], DimActivity[ActivityID] = "ACT-LOAD" )
define MEASURE '_measures'[Development Metres] = CALCULATE ( [Production Quantity], DimActivity[ActivityID] = "ACT-DEV" )
define MEASURE '_measures'[Ground Support Bolts] = CALCULATE ( [Production Quantity], DimActivity[ActivityID] = "ACT-GS" )
define MEASURE '_measures'[Auxiliary Trips] = CALCULATE ( [Production Quantity], DimActivity[ActivityID] = "ACT-AUX" )
define MEASURE '_measures'[Haul Truck Scheduled Hours] = CALCULATE ( [Scheduled Hours], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck Available Hours] = CALCULATE ( [Available Hours], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck Operating Hours] = CALCULATE ( [Operating Hours], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck Productive Hours] = CALCULATE ( [Productive Hours], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck PA] = CALCULATE ( [Physical Availability], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck UoA] = CALCULATE ( [Use of Availability], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Haul Truck Prod Eff] = CALCULATE ( [Productive Efficiency], DimEquipment[EquipmentClass] = "Haul truck" )
define MEASURE '_measures'[Tonnes / Productive h] = DIVIDE ( [Tonnes Hauled], [Haul Truck Productive Hours] )
define MEASURE '_measures'[Tonnes / Operating h] = DIVIDE ( [Tonnes Hauled], [Haul Truck Operating Hours] )
define MEASURE '_measures'[Tonnes / Scheduled h] = DIVIDE ( [Tonnes Hauled], [Haul Truck Scheduled Hours] )
define MEASURE '_measures'[Tonnes / Unit] = DIVIDE ( [Tonnes Hauled], CALCULATE ( DISTINCTCOUNT ( DimEquipment[UnitCode] ), DimEquipment[EquipmentClass] = "Haul truck" ) * 1000 )
define MEASURE '_measures'[Haulage Variance Tonnes] = [Tonnes Hauled] - [Haulage Plan Tonnes]
define MEASURE '_measures'[Haulage Variance kt] = DIVIDE ( [Haulage Variance Tonnes], 1000 )
define MEASURE '_measures'[Mean Haul Distance] = CALCULATE ( AVERAGE ( FactProduction[HaulDistanceKm] ), DimActivity[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Mean Road Condition Index] = CALCULATE ( AVERAGE ( FactProduction[RoadConditionIndex] ), DimActivity[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Mean Congestion Index] = CALCULATE ( AVERAGE ( FactProduction[CongestionIndex] ), DimActivity[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Plan Scheduled Hours] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) RETURN CALCULATE ( SUM ( FactPlan[PlanScheduledHours] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), FactPlan[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Target PA] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) RETURN CALCULATE ( AVERAGE ( FactPlan[TargetPA] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), FactPlan[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Target UoA] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) RETURN CALCULATE ( AVERAGE ( FactPlan[TargetUoA] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), FactPlan[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Target Productive Efficiency] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) RETURN CALCULATE ( AVERAGE ( FactPlan[TargetProductiveEfficiency] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), FactPlan[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Target Haulage Rate] = VAR _months = VALUES ( DimDate[FiscalMonthNumber] ) RETURN CALCULATE ( AVERAGE ( FactPlan[TargetRatePerProductiveHour] ), TREATAS ( _months, FactPlan[FiscalMonthNumber] ), FactPlan[ActivityID] = "ACT-HAUL" )
define MEASURE '_measures'[Bridge Budget Tonnes] = [Plan Scheduled Hours] * [Target PA] * [Target UoA] * [Target Productive Efficiency] * [Target Haulage Rate]
define MEASURE '_measures'[Bridge Schedule Impact] = ( [Haul Truck Scheduled Hours] - [Plan Scheduled Hours] ) * [Target PA] * [Target UoA] * [Target Productive Efficiency] * [Target Haulage Rate]
define MEASURE '_measures'[Bridge Availability Impact] = [Haul Truck Scheduled Hours] * ( [Haul Truck PA] - [Target PA] ) * [Target UoA] * [Target Productive Efficiency] * [Target Haulage Rate]
define MEASURE '_measures'[Bridge Utilisation Impact] = [Haul Truck Scheduled Hours] * [Haul Truck PA] * ( [Haul Truck UoA] - [Target UoA] ) * [Target Productive Efficiency] * [Target Haulage Rate]
define MEASURE '_measures'[Bridge Productive Efficiency Impact] = [Haul Truck Scheduled Hours] * [Haul Truck PA] * [Haul Truck UoA] * ( [Haul Truck Prod Eff] - [Target Productive Efficiency] ) * [Target Haulage Rate]
define MEASURE '_measures'[Bridge Rate Impact] = [Haul Truck Scheduled Hours] * [Haul Truck PA] * [Haul Truck UoA] * [Haul Truck Prod Eff] * ( [Tonnes / Productive h] - [Target Haulage Rate] )
define MEASURE '_measures'[Bridge Calculated Actual] = [Bridge Budget Tonnes] + [Bridge Schedule Impact] + [Bridge Availability Impact] + [Bridge Utilisation Impact] + [Bridge Productive Efficiency Impact] + [Bridge Rate Impact]
define MEASURE '_measures'[Bridge Reconciliation Difference] = [Tonnes Hauled] - [Bridge Calculated Actual]
define MEASURE '_measures'[Correlation — Haul Distance vs Rate] = VAR _t = ADDCOLUMNS ( FILTER ( FactProduction, FactProduction[ActivityID] = "ACT-HAUL" && FactProduction[EventDurationMinutes] > 0 && NOT ISBLANK ( FactProduction[HaulDistanceKm] ) ), "__x", FactProduction[HaulDistanceKm], "__y", DIVIDE ( FactProduction[Quantity], FactProduction[EventDurationMinutes] / 60.0 ) ) VAR _ax = AVERAGEX ( _t, [__x] ) VAR _ay = AVERAGEX ( _t, [__y] ) VAR _num = SUMX ( _t, ( [__x] - _ax ) * ( [__y] - _ay ) ) VAR _dx = SUMX ( _t, POWER ( [__x] - _ax, 2 ) ) VAR _dy = SUMX ( _t, POWER ( [__y] - _ay, 2 ) ) RETURN DIVIDE ( _num, SQRT ( _dx * _dy ) )
define MEASURE '_measures'[Correlation — Road Condition vs Rate] = VAR _t = ADDCOLUMNS ( FILTER ( FactProduction, FactProduction[ActivityID] = "ACT-HAUL" && FactProduction[EventDurationMinutes] > 0 && NOT ISBLANK ( FactProduction[RoadConditionIndex] ) ), "__x", FactProduction[RoadConditionIndex], "__y", DIVIDE ( FactProduction[Quantity], FactProduction[EventDurationMinutes] / 60.0 ) ) VAR _ax = AVERAGEX ( _t, [__x] ) VAR _ay = AVERAGEX ( _t, [__y] ) VAR _num = SUMX ( _t, ( [__x] - _ax ) * ( [__y] - _ay ) ) VAR _dx = SUMX ( _t, POWER ( [__x] - _ax, 2 ) ) VAR _dy = SUMX ( _t, POWER ( [__y] - _ay, 2 ) ) RETURN DIVIDE ( _num, SQRT ( _dx * _dy ) )
define MEASURE '_measures'[Correlation — Congestion vs Rate] = VAR _t = ADDCOLUMNS ( FILTER ( FactProduction, FactProduction[ActivityID] = "ACT-HAUL" && FactProduction[EventDurationMinutes] > 0 && NOT ISBLANK ( FactProduction[CongestionIndex] ) ), "__x", FactProduction[CongestionIndex], "__y", DIVIDE ( FactProduction[Quantity], FactProduction[EventDurationMinutes] / 60.0 ) ) VAR _ax = AVERAGEX ( _t, [__x] ) VAR _ay = AVERAGEX ( _t, [__y] ) VAR _num = SUMX ( _t, ( [__x] - _ax ) * ( [__y] - _ay ) ) VAR _dx = SUMX ( _t, POWER ( [__x] - _ax, 2 ) ) VAR _dy = SUMX ( _t, POWER ( [__y] - _ay, 2 ) ) RETURN DIVIDE ( _num, SQRT ( _dx * _dy ) )
define MEASURE '_measures'[Correlation — Crew Skill vs Rate] = VAR _t = ADDCOLUMNS ( FILTER ( FactProduction, FactProduction[ActivityID] = "ACT-HAUL" && FactProduction[EventDurationMinutes] > 0 ), "__x", LOOKUPVALUE ( FactRoster[OperatorSkillIndex], FactRoster[DateKey], FactProduction[DateKey], FactRoster[UnitCode], FactProduction[UnitCode], FactRoster[ShiftKey], FactProduction[ShiftKey] ), "__y", DIVIDE ( FactProduction[Quantity], FactProduction[EventDurationMinutes] / 60.0 ) ) VAR _valid = FILTER ( _t, NOT ISBLANK ( [__x] ) ) VAR _ax = AVERAGEX ( _valid, [__x] ) VAR _ay = AVERAGEX ( _valid, [__y] ) VAR _num = SUMX ( _valid, ( [__x] - _ax ) * ( [__y] - _ay ) ) VAR _dx = SUMX ( _valid, POWER ( [__x] - _ax, 2 ) ) VAR _dy = SUMX ( _valid, POWER ( [__y] - _ay, 2 ) ) RETURN DIVIDE ( _num, SQRT ( _dx * _dy ) )
define MEASURE '_measures'[Correlation — Unit Derating vs Rate] = VAR _t = ADDCOLUMNS ( FILTER ( FactProduction, FactProduction[ActivityID] = "ACT-HAUL" && FactProduction[EventDurationMinutes] > 0 ), "__x", 1 - LOOKUPVALUE ( FactCondition[ConditionIndex], FactCondition[DateKey], FactProduction[DateKey], FactCondition[UnitCode], FactProduction[UnitCode] ), "__y", DIVIDE ( FactProduction[Quantity], FactProduction[EventDurationMinutes] / 60.0 ) ) VAR _valid = FILTER ( _t, NOT ISBLANK ( [__x] ) ) VAR _ax = AVERAGEX ( _valid, [__x] ) VAR _ay = AVERAGEX ( _valid, [__y] ) VAR _num = SUMX ( _valid, ( [__x] - _ax ) * ( [__y] - _ay ) ) VAR _dx = SUMX ( _valid, POWER ( [__x] - _ax, 2 ) ) VAR _dy = SUMX ( _valid, POWER ( [__y] - _ay, 2 ) ) RETURN DIVIDE ( _num, SQRT ( _dx * _dy ) )
define MEASURE '_measures'[Selected Unit] = SELECTEDVALUE ( DimEquipment[UnitCode], "Multiple units" )
define MEASURE '_measures'[Latest Condition Index] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[ConditionIndex] )
define MEASURE '_measures'[Latest SMU] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[SMUHours] )
define MEASURE '_measures'[Latest Hydraulic Oil Temp] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[HydraulicOilTempC] )
define MEASURE '_measures'[Latest Fe Particles] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[FeParticlesPPM] )
define MEASURE '_measures'[Brake Test Days Overdue] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[BrakeTestDaysOverdue] )
define MEASURE '_measures'[Active Condition Alerts] = MAXX ( TOPN ( 1, FactCondition, FactCondition[ReadingTimestamp], DESC ), FactCondition[ActiveAlertCount] )
define MEASURE '_measures'[Last PM Actual SMU] = MAXX ( TOPN ( 1, FactPM, FactPM[ServiceDate], DESC ), FactPM[ActualSMU] )
define MEASURE '_measures'[Last PM Interval] = MAXX ( TOPN ( 1, FactPM, FactPM[ServiceDate], DESC ), FactPM[PMIntervalSMU] )
define MEASURE '_measures'[Next PM at SMU] = [Last PM Actual SMU] + [Last PM Interval]
define MEASURE '_measures'[SMU Remaining to PM] = MAX ( 0, [Next PM at SMU] - [Latest SMU] )
define MEASURE '_measures'[MTBF Class Median] = VAR _class = SELECTEDVALUE ( DimEquipment[EquipmentClass] ) RETURN MEDIANX ( FILTER ( ALLSELECTED ( DimEquipment ), DimEquipment[EquipmentClass] = _class ), CALCULATE ( [MTBF] ) )
define MEASURE '_measures'[MTBF vs Class Median] = [MTBF] - [MTBF Class Median]
define MEASURE '_measures'[Availability Loss vs Fleet Median] = MAX ( 0, ( [Fleet Median PA] - [Physical Availability] ) * 100 )
define MEASURE '_measures'[Hydraulics Breakdown Share] = DIVIDE ( CALCULATE ( [Breakdown Hours], DimComponent[ComponentName] = "Hydraulics" ), [Breakdown Hours] )
define MEASURE '_measures'[Actual Loss Hours] = [Scheduled Hours] - [Productive Hours]
define MEASURE '_measures'[Opportunity Reduction %] = 0.20
define MEASURE '_measures'[Top 2 Controllable Reasons Hours] = VAR _reasons = CALCULATETABLE ( VALUES ( DimDelayReason[Reason] ), DimDelayReason[ControlClass] = "Controllable" ) RETURN SUMX ( TOPN ( 2, _reasons, [Delay Hours], DESC ), [Delay Hours] )
define MEASURE '_measures'[Reason Benchmark Gap Hours] = [Top 2 Controllable Reasons Hours] * [Opportunity Reduction %]
define MEASURE '_measures'[Estimated Opportunity Tonnes] = DIVIDE ( [Reason Benchmark Gap Hours] * [Haul Truck Prod Eff] * [Tonnes / Productive h], 1000 )
define MEASURE '_measures'[Unit Controllable Loss Rate] = DIVIDE ( [Controllable Delay Hours], [Calendar Hours] )
define MEASURE '_measures'[Best Quartile Unit Controllable Loss Rate] = VAR _units = ALLSELECTED ( DimEquipment[UnitCode] ) RETURN PERCENTILEX.INC ( _units, CALCULATE ( [Unit Controllable Loss Rate] ), 0.25 )
define MEASURE '_measures'[Unit Benchmark Gap Hours] = VAR _bq = [Best Quartile Unit Controllable Loss Rate] VAR _units = ALLSELECTED ( DimEquipment[UnitCode] ) RETURN SUMX ( _units, VAR _rate = CALCULATE ( [Unit Controllable Loss Rate] ) VAR _cal = CALCULATE ( [Calendar Hours] ) RETURN MAX ( 0, ( _rate - _bq ) * _cal ) )
define MEASURE '_measures'[Opportunity vs Plan %] = DIVIDE ( [Estimated Opportunity Tonnes] * 1000, [Haulage Plan Tonnes] )
define MEASURE '_measures'[Open WOs by Age Bucket] = VAR _asof = MAX ( DimDate[Date] ) + 1 VAR _bucket = SELECTEDVALUE ( BacklogAgeBucket[Bucket] ) RETURN CALCULATE ( COUNTROWS ( FactWorkOrder ), REMOVEFILTERS ( DimDate ), FILTER ( FactWorkOrder, VAR _age = DATEDIFF ( FactWorkOrder[StartTimestamp], _asof, DAY ) VAR _open = FactWorkOrder[StartTimestamp] < _asof && ( ISBLANK ( FactWorkOrder[CloseTimestamp] ) || FactWorkOrder[CloseTimestamp] >= _asof ) RETURN _open && SWITCH ( _bucket, "<7 d", _age < 7, "7-14 d", _age >= 7 && _age < 14, "14-30 d", _age >= 14 && _age < 30, "30-60 d", _age >= 30 && _age < 60, "60+ d", _age >= 60, FALSE () ) ) )
